---
import BasicLayout from "../layouts/BasicLayout.astro";

const title = "Ulrich-Matthias Schäfer — Consultant & Webentwickler";
const description =
  "Portfolio von Ulrich-Matthias Schäfer (Ulima) — Consultant & Webentwickler, Schöpfer von SVG.js und Open-Source-Enthusiast.";

const services = [
  {
    title: "Vue 2 → Vue 3 Migration",
    description:
      "Ihr Projekt hängt noch auf Vue 2 fest? Ich migriere Codebasen strukturiert und sicher zu Vue 3 — inklusive Composition API, neuer Toolchain und Testing.",
    link: "https://migrate-vue.com",
    linkLabel: "migrate-vue.com",
    icon: "migrate",
  },
  {
    title: "Custom APIs & Datenintegration",
    description:
      "Sie brauchen eine API, die Daten von verschiedenen Quellen abfragt, verarbeitet oder aggregiert? Ich baue maßgeschneiderte Lösungen — schnell, zuverlässig, wartbar.",
    icon: "api",
  },
  {
    title: "Codebase Cleanup & Refactoring",
    description:
      "Gewachsene Codebasis, technische Schulden, inkonsistente Architektur? Ich bringe Struktur rein — von Quick Wins bis zur vollständigen Neuausrichtung.",
    icon: "cleanup",
  },
  {
    title: "Frontend Architektur & Consulting",
    description:
      "Beratung zu Technologiewahl, Projektstruktur, Performance und Best Practices. Ich helfe Teams, bessere Entscheidungen zu treffen und schneller zu liefern.",
    icon: "consulting",
  },
];

const projects = [
  {
    title: "Elephant Company",
    url: "https://www.elephant-company.com",
    role: "Senior Frontend Developer",
    description:
      "Übernahme einer KI-generierten Codebasis (Claude) mit Duplikation und Overengineering. Refactoring zu einer wartbaren Frontend-Architektur mit geteilten Komponenten-Systemen, vue-query und vue-i18n. Aufbau interaktiver KI-gestützter UI (Chat + Fragebogen-Flows) mit starkem UX-Fokus.",
    tags: ["Vue", "TypeScript", "vue-query", "vue-i18n"],
  },
  {
    title: "YPOG",
    url: "https://www.ypog.law",
    role: "Senior Frontend Developer",
    description:
      "Design und Implementierung komplexer, rechtskonformer Workflows für die Steuererklärung von Investmentfonds. Aufbau eines Frontends für hochstrukturierte, nachvollziehbare Dateneingaben mit vollständiger Datenherkunft, dynamischer Validierung und Audit-Fähigkeit.",
    tags: ["Vue", "TypeScript", "Compliance"],
  },
  {
    title: "Helmholtz-Zentrum für Umweltforschung (UFZ)",
    url: "https://www.ufz.de",
    role: "Senior Fullstack Developer",
    description:
      "Backend zunächst in Laravel, dann Migration zu Go für hochdurchsatz Simulationsworkloads (Waldwachstumsmodellierung). Frontend-Rendering großer Geodaten (einzelne Bäume) mit OpenLayers + WebWorkers. System von unbenutzbar zu flüssiger, interaktiver Erfahrung transformiert.",
    tags: ["Go", "Laravel", "Vue", "OpenLayers", "WebWorkers"],
  },
  {
    title: "tixity",
    url: "https://www.tixity.com",
    role: "Lead Frontend Developer",
    description:
      "Leitung des Frontend-Rewrites einer Ticketing-Plattform. Migration zu Vue 3, Vite und TypeScript. Performance-Engpässe bei ~10k+ Sitzplan-Elementen durch Wechsel von SVG zu WebGL (Pixi.js) gelöst. Custom-Editor für Venue-Design gebaut. Architektur und technische Entscheidungen verantwortet.",
    tags: ["Vue 3", "TypeScript", "Pixi.js", "WebGL", "Vite"],
    image: "/projects/map-designer.jpg",
  },
  {
    title: "Packmatic",
    url: "https://www.packmatic.com",
    role: "Senior Frontend Developer",
    description:
      "Entwicklung und Architektur einer B2B-Plattform für komplexe Verpackungs-Workflows (Spezifikation → Lieferanten-Matching → Sampling → Bestellung). Skalierbare Frontend-Architektur und Handling komplexer relationaler Daten über hunderte Unternehmen.",
    tags: ["Vue", "TypeScript", "B2B"],
  },
  {
    title: "The Estimating Edge",
    url: "https://www.estimatingedge.com",
    role: "Lead Frontend Developer",
    description:
      "Leitung der Entwicklung eines browserbasierten Baukostenabschätzungs-Tools (Planvermessung → Kostenschätzung). Frontend-Architektur, Tooling und Datenstrukturen definiert. Kern-Zeichen- und Messlogik im Browser gebaut. Team in Vue 3 gecoacht.",
    tags: ["Vue 3", "TypeScript", "C#", "Canvas"],
  },
  {
    title: "LIVE Online Math",
    url: "https://www.liveonlinemath.de",
    role: "Lead Fullstack Developer",
    description:
      "Aufbau einer Online-Lehrplattform mit Echtzeit-Unterricht basierend auf Jitsi (angepasst mit Breakout-Räumen und Authentifizierung). Kollaboratives SVG-basiertes Whiteboard mit Custom Real-Time Sync Engine (Node.js).",
    tags: ["Vue", "Node.js", "Jitsi", "SVG", "WebRTC"],
  },
  {
    title: "media project academy",
    url: "https://www.mediaprojectacademy.de",
    role: "Dozent",
    description:
      "Lehre der Grundkonzepte von HTML, CSS, JavaScript und PHP im Rahmen strukturierter Schulungsformate.",
    tags: ["HTML", "CSS", "JavaScript", "PHP"],
  },
];
---

<BasicLayout title={title} description={description}>
  <div class="page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <h1 class="hero-name fade-in">Ulrich-Matthias<br />Schäfer</h1>
          <p class="hero-role fade-in">Consultant & Webentwickler</p>
          <p class="hero-tagline fade-in">
            Über ein Jahrzehnt Erfahrung in der Entwicklung moderner
            Webanwendungen.
          </p>
        </div>
        <div class="hero-image fade-in">
          <img
            src="/profile/profile_closeup.jpg"
            alt="Ulrich-Matthias Schäfer"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <div class="divider" aria-hidden="true">
      <span class="divider-dot"></span>
    </div>

    <!-- Über mich -->
    <section class="section reveal">
      <div class="section-label-wrap">
        <span class="section-number">01</span>
        <h2 class="section-heading">Über mich</h2>
      </div>
      <p class="section-body">
        Mit über einem Jahrzehnt Erfahrung in der Frontend-Entwicklung bringe
        ich tiefgreifendes Wissen in modernen Web-Technologien mit. Als Schöpfer
        von SVG.js und Contributor zu zahlreichen Open-Source-Projekten verbinde
        ich technische Exzellenz mit einem Auge für Design und
        Benutzerfreundlichkeit.
      </p>
    </section>

    <div class="divider" aria-hidden="true">
      <span class="divider-dot"></span>
    </div>

    <!-- Was ich anbiete -->
    <section class="section reveal">
      <div class="section-label-wrap">
        <span class="section-number">02</span>
        <h2 class="section-heading">Was ich anbiete</h2>
      </div>
      <p class="section-body" style="margin-bottom: 40px;">
        Ich unterstütze Teams und Unternehmen dabei, ihre Webprojekte auf das
        nächste Level zu bringen — ob Migration, Architektur oder Cleanup.
      </p>
      <div class="services-grid">
        {
          services.map((service) => (
            <article class="service-card">
              <div class="service-icon" data-icon={service.icon}>
                {service.icon === "migrate" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3v18m0-18l-3 3m3-3l3 3m-3 15l-3-3m3 3l3-3M3 12h18m-18 0l3-3m-3 3l3 3m15-3l-3-3m3 3l-3 3" />
                  </svg>
                )}
                {service.icon === "api" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 1v4m0 14v4M4.22 4.22l2.83 2.83m9.9 9.9l2.83 2.83M1 12h4m14 0h4M4.22 19.78l2.83-2.83m9.9-9.9l2.83-2.83" />
                  </svg>
                )}
                {service.icon === "cleanup" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 4l16 16M12 2a10 10 0 1 0 10 10" />
                    <path d="M16 8l-4 4" />
                  </svg>
                )}
                {service.icon === "consulting" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  </svg>
                )}
              </div>
              <h3 class="service-title">{service.title}</h3>
              <p class="service-desc">{service.description}</p>
              {service.link && (
                <a
                  href={service.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="service-link"
                >
                  {service.linkLabel} →
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <div class="divider" aria-hidden="true">
      <span class="divider-dot"></span>
    </div>

    <!-- Technologien -->
    <section class="section reveal">
      <div class="section-label-wrap">
        <span class="section-number">03</span>
        <h2 class="section-heading">Technologien</h2>
      </div>
      <p class="skills-line">
        TypeScript<span class="sep">&middot;</span>Vue<span class="sep"
          >&middot;</span
        >Go<span class="sep">&middot;</span>Astro<span class="sep"
          >&middot;</span
        >Vite<span class="sep">&middot;</span>PHP<span class="sep"
          >&middot;</span
        >Node.js<span class="sep">&middot;</span>Nuxt<span class="sep"
          >&middot;</span
        >Laravel<span class="sep">&middot;</span>PostgreSQL<span class="sep"
          >&middot;</span
        >Tailwind
      </p>
      <p class="skills-line secondary">
        JavaScript<span class="sep">&middot;</span>HTML<span class="sep"
          >&middot;</span
        >CSS<span class="sep">&middot;</span>SVG<span class="sep">&middot;</span
        >WebGL<span class="sep">&middot;</span>OpenLayers<span class="sep"
          >&middot;</span
        >Pixi.js<span class="sep">&middot;</span>vue-query<span class="sep"
          >&middot;</span
        >Animation<span class="sep">&middot;</span>Git<span class="sep"
          >&middot;</span
        >Accessibility<span class="sep">&middot;</span>Performance
      </p>
    </section>

    <div class="divider" aria-hidden="true">
      <span class="divider-dot"></span>
    </div>

    <!-- Open Source -->
    <section class="section reveal">
      <div class="section-label-wrap">
        <span class="section-number">04</span>
        <h2 class="section-heading">Open Source</h2>
      </div>
      <p class="section-body" style="margin-bottom: 36px;">
        Als leidenschaftlicher Open-Source-Contributor glaube ich an die Kraft
        geteilten Wissens und gemeinschaftlicher Softwareentwicklung.
      </p>

      <div class="oss-item">
        <div class="oss-item-body">
          <h3 class="oss-item-title">
            <a
              href="https://svgjs.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="oss-link"
            >
              <svg
                class="svgjs-logo"
                viewBox="0 0 326 326"
                fill="#ff0066"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  width="230"
                  height="230"
                  x="48"
                  y="48"
                  transform="rotate(45 163 163)"></rect>
                <g stroke="#fff" stroke-width="5">
                  <path
                    d="M163 70 C 70 163 256 163 163 256"
                    stroke-width="13"
                    fill="none"
                    stroke-linecap="round"></path>
                  <line x1="163" y1="70" x2="70" y2="163"></line>
                  <line x1="256" y1="163" x2="163" y2="256"></line>
                  <circle r="6" cx="70" cy="163"></circle>
                  <circle r="6" cx="256" cy="163"></circle>
                </g>
              </svg>
              SVG.js
            </a>
          </h3>
          <p class="oss-item-desc">
            Schöpfer und Maintainer von SVG.js — der leichtgewichtigen
            Bibliothek für SVG-Manipulation im Web mit über 10.000 GitHub Stars.
            Modular, performant und mit einer eleganten, verkettbaren API.
          </p>
          <div class="tag-list">
            <span class="tag">JavaScript</span>
            <span class="tag">SVG</span>
            <span class="tag">Open Source</span>
          </div>
        </div>
      </div>

      <div class="oss-item">
        <div class="oss-item-body">
          <h3 class="oss-item-title">
            <a
              href="https://e18e.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="oss-link"
            >
              <img
                src="https://e18e.dev/logo.svg"
                alt="e18e"
                class="e18e-logo"
              />
              e18e (Ecosystem Performance)
            </a>
          </h3>
          <p class="oss-item-desc">
            Contributor bei e18e — einer Initiative zur Verbesserung der
            Performance des JavaScript-Ökosystems. Cleanup, Speedup, Levelup —
            ein Paket nach dem anderen.
          </p>
        </div>
      </div>

      <div class="oss-item">
        <div class="oss-item-body">
          <h3 class="oss-item-title">
            <svg
              class="oss-contrib-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="18" cy="18" r="3"></circle>
              <circle cx="6" cy="6" r="3"></circle>
              <path d="M6 21V9a9 9 0 0 0 9 9"></path>
            </svg>
            Weitere Beiträge
          </h3>
          <p class="oss-item-desc">
            Contributions zu zahlreichen Projekten im JavaScript-Ökosystem,
            darunter Vue, Nuxt, npmx.dev und viele mehr.
          </p>
        </div>
      </div>
    </section>

    <div class="divider" aria-hidden="true">
      <span class="divider-dot"></span>
    </div>

    <!-- Projekte -->
    <section class="section reveal">
      <div class="section-label-wrap">
        <span class="section-number">05</span>
        <h2 class="section-heading">Projekte</h2>
      </div>
      <div class="projects-timeline">
        {
          projects.map((project) => (
            <article class="project-card">
              <span class="project-role-tag">{project.role}</span>
              {project.url ? (
                <h3 class="project-title">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                  >
                    {project.title}
                  </a>
                </h3>
              ) : (
                <h3 class="project-title">{project.title}</h3>
              )}
              <div class="project-card-inner">
                <div class="project-card-text">
                  <p class="project-desc">{project.description}</p>
                  <div class="tag-list">
                    {project.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </div>
                {project.image && (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="project-thumb"
                    loading="lazy"
                  />
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <div class="divider" aria-hidden="true">
      <span class="divider-dot"></span>
    </div>

    <!-- Kontakt -->
    <section class="section section--contact reveal">
      <h2 class="section-heading contact-heading">
        Lassen Sie uns zusammenarbeiten
      </h2>
      <p
        class="section-body"
        style="text-align: center; max-width: 100%; margin-bottom: 28px;"
      >
        Ich freue mich auf Ihre Nachricht.
      </p>
      <a href="mailto:mail@fuzzyma.de" class="contact-email">mail@fuzzyma.de</a>
      <div class="social-links">
        <a
          href="https://github.com/Fuzzyma"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"
            ><path
              d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.185 6.839 9.51.5.092.682-.218.682-.483 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.339-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.338c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.31.678.921.678 1.856 0 1.34-.012 2.42-.012 2.749 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.021C22 6.484 17.522 2 12 2z"
            ></path></svg
          >
        </a>
        <a
          href="https://linkedin.com/in/ulima"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM6.864 20.452H3.809V9h3.055v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path></svg
          >
        </a>
        <a
          href="https://bsky.app/profile/fuzzyma.bsky.social"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bluesky"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"
            ><path
              d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.594 6.456.756 2.823 3.46 3.76 5.919 3.505-4.177.6-6.786 2.278-3.903 6.023C5.41 23.013 10.16 21.012 12 17.78c1.84 3.233 6.59 5.233 9.39 1.972 2.883-3.745.274-5.423-3.903-6.023 2.459.255 5.163-.682 5.919-3.505.216-.806.594-5.767.594-6.456 0-.688-.139-1.86-.902-2.203-.659-.3-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"
            ></path></svg
          >
        </a>
      </div>
    </section>

    <footer class="page-footer">
      <p>&copy; {new Date().getFullYear()} Ulrich-Matthias Schäfer</p>
    </footer>
  </div>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  </script>
</BasicLayout>

<style is:global>
  body {
    height: auto !important;
    display: block !important;
    background: #090b10 !important;
  }
</style>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap");

  :root {
    --accent: #c9a227;
    --accent-light: #d4a853;
    --bg: #090b10;
    --text: #f5f5f0;
    --text-muted: #a8a29e;
    --font: "Space Grotesk", sans-serif;
    --max-w: 960px;
  }

  .page {
    font-family: var(--font);
    color: var(--text);
    background: var(--bg);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Subtle fade-in (hero only) ── */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    opacity: 0;
    animation: fadeIn 0.7s ease forwards;
    animation-delay: 0.15s;
  }

  /* ── Scroll reveal (sections) ── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ══════════════════════════════
     HERO
  ══════════════════════════════ */
  .hero {
    padding: 100px 24px 80px;
    max-width: 1060px;
    margin: 0 auto;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 60px;
  }

  .hero-text {
    flex: 1 1 55%;
  }

  .hero-name {
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: var(--text);
  }

  .hero-role {
    font-weight: 500;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--accent);
    margin: 0 0 16px;
    letter-spacing: 0.02em;
  }

  .hero-tagline {
